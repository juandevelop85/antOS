#!/usr/bin/env bash
# antOS Desktop · Wayland Session Autostart
# Launched automatically by the compositor on session start.
#
# Idempotente (T30.6): si el compositor reinicia la sesión —greetd hace justo
# eso cuando el compositor sale, y bajo emulación el primer arranque en frío
# puede tardar de más y provocarlo—, este guion no debe dejar dos
# `antos-barra` (ni dos de nada) apilados. De ahí el `pgrep -f` antes de cada
# lanzamiento.
set -euo pipefail

# 1. Ensure antOS daemon is running.
#    En NixOS el demonio es un servicio systemd (T31.18) y esta rama no hace
#    nada; en un Linux de desarrollo con el binario en el PATH, lo levanta.
if command -v antosd >/dev/null 2>&1; then
    pgrep -x antosd >/dev/null 2>&1 || antosd >/dev/null 2>&1 &
elif [ -x "./target/debug/antosd" ]; then
    pgrep -f "target/debug/antosd" >/dev/null 2>&1 || ./target/debug/antosd >/dev/null 2>&1 &
fi

# 2. Launch antOS Desktop Bar (GTK4 Layer-Shell).
#    Margen antes de conectar el layer-shell: mismo motivo ya documentado
#    para waybar/swaybg/mako en `panelAutostart` (T30.6, system/nixos/
#    desktop.nix) — bajo emulación, el primer arranque en frío puede
#    ganarle la carrera al compositor terminando de anunciar
#    `zwlr_layer_shell_v1`. Sin este margen, `antos-barra` arrancaba,
#    creaba la ventana y moría sin llegar a pintar ninguna superficie
#    visible (visto en la VM: `pgrep -f antos-barra` no encontraba nada
#    tras el arranque, pero lanzada a mano segundos después sí funcionaba).
sleep 1
if command -v antos-barra >/dev/null 2>&1; then
    pgrep -f antos-barra >/dev/null 2>&1 || antos-barra >/dev/null 2>&1 &
elif [ -x "./system/barra/target/debug/antos-barra" ]; then
    pgrep -f antos-barra >/dev/null 2>&1 || ./system/barra/target/debug/antos-barra >/dev/null 2>&1 &
fi
