<?xml version="1.0" encoding="UTF-8"?>
<!--
  antOS Desktop · Declarative Wayland Compositor Configuration (Labwc)
  Ticket: T13.0
  Provides ultra-lightweight (~30-40 MB RAM) window management,
  wlr-layer-shell anchor support for antos-barra, wlr-screencopy,
  and native antOS developer hotkeys.
-->
<labwc_config>
  <core>
    <gap>4</gap>
  </core>

  <!-- Window Decoration and Theme -->
  <theme>
    <name>antOS-Dark</name>
    <cornerRadius>6</cornerRadius>
    <font name="monospace" size="10"/>
  </theme>

  <!-- Keyboard and Global Hotkeys -->
  <keyboard>
    <default/>

    <!-- antOS Core Developer Keybindings -->

    <!-- Super + Space: Focus / Toggle antOS Intent Bar -->
    <keybind key="W-space">
      <action name="Execute" command="antos intent 'enfocar barra'"/>
    </keybind>

    <!-- Super + A: Agent Control Center and Ticket Board -->
    <keybind key="W-a">
      <action name="Execute" command="antos intent 'abre el centro de control de agentes'"/>
    </keybind>

    <!-- Super + Return: Interactive Virtual Terminal (vte) -->
    <keybind key="W-Return">
      <action name="Execute" command="antos vte"/>
    </keybind>

    <!-- Super + D: Interactive Diff Viewer & Rollback -->
    <keybind key="W-d">
      <action name="Execute" command="antos intent 'ver diffs'"/>
    </keybind>

    <!-- Super + E: Default Text Editor (Neovim) -->
    <keybind key="W-e">
      <action name="Execute" command="antos edit"/>
    </keybind>

    <!-- Super + W: Integrated Dev TUI Workspace (Neovim + antFlow + DiffViewer) -->
    <keybind key="W-w">
      <action name="Execute" command="antos dev"/>
    </keybind>

    <!-- Traditional desktop shortcuts (T30.6). No-ops if `panel` is disabled:
         the binaries simply are not on PATH. -->

    <!-- Super + P: application launcher -->
    <keybind key="W-p">
      <action name="Execute" command="fuzzel"/>
    </keybind>

    <!-- Super + L: lock screen -->
    <keybind key="W-l">
      <action name="Execute" command="swaylock -f"/>
    </keybind>

    <!-- Print: screenshot to ~/Pictures -->
    <keybind key="Print">
      <action name="Execute" command="sh -c 'mkdir -p ~/Pictures &amp;&amp; grim ~/Pictures/$(date +%Y%m%d-%H%M%S).png'"/>
    </keybind>

    <!-- Window Management Shortcuts -->
    <!-- Super + Q: Close Active Window -->
    <keybind key="W-q">
      <action name="Close"/>
    </keybind>

    <!-- Alt + Tab: Window Switcher -->
    <keybind key="A-Tab">
      <action name="NextWindow"/>
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PreviousWindow"/>
    </keybind>

    <!-- Super + F: Toggle Fullscreen -->
    <keybind key="W-f">
      <action name="ToggleFullscreen"/>
    </keybind>

    <!-- Super + Shift + E: Exit Desktop Session -->
    <keybind key="W-S-e">
      <action name="Exit"/>
    </keybind>
  </keyboard>

  <!-- Window Rules -->
  <windowRules>
    <!-- antOS Intent Bar and Notification Windows: Floating / Borderless -->
    <windowRule identifier="antos-barra" serverDecoration="no" skipTaskbar="yes"/>
    <!-- Agent Center Dialog: Centered Floating -->
    <windowRule identifier="antos-agent-center" openFloating="yes" serverDecoration="yes"/>
    <!-- Diff Viewer Dialog: Centered Floating with Min Size -->
    <windowRule identifier="antos-diff-view" openFloating="yes" serverDecoration="yes"/>
  </windowRules>
</labwc_config>
